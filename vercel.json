{
  "crons": [
    {
      "path": "/api/cron/fetch-news",
      "schedule": "0 */48 * * *"
    },
    {
      "path": "/api/generate-trends",
      "schedule": "0 13 * * 5"
    },
    {
      "path": "/api/devs/weekly-report/trigger",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/beta", "destination": "/index.html" },
    { "source": "/devs", "destination": "/index.html" }
  ]
}
